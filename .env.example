# Copy this file to ".env" and fill in ONE of the chat options. Then restart: npm start

# Option 1 (recommended): Google Gemini. Also turns on server speech-to-text for Bangla voice notes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option 2: any OpenAI-compatible service.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Option 3: an Azure OpenAI deployment that speaks the Responses API.
ASTRA_URL=
ASTRA_API_KEY=
ASTRA_MODEL=

# Pictures use the local "neoimg" command (gpt-image-2). Size 1k is faster, 2k is sharper.
IMAGE_SIZE=2k
IMAGE_QUALITY=high

PORT=4900
